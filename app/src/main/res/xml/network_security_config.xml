<?xml version="1.0" encoding="utf-8"?>
<!--
  The server's address is typed in by whoever owns the app and, while developing, is often
  a bare address on their own network, such as 192.168.1.5:8430, or 10.0.2.2:8430 from the
  emulator. Android has no way to express "any private address", so plain HTTP has to stay
  possible in general. Every host the app reaches on its own is pinned to HTTPS below, so
  the only thing that can travel in the clear is a server the owner deliberately pointed
  it at.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">streetsweep.net</domain>
        <domain includeSubdomains="true">tile.openstreetmap.org</domain>
    </domain-config>
</network-security-config>
