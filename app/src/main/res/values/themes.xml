<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.StreetSweep" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_window</item>
    </style>

    <!-- What the launcher draws while the process starts: the pin in the middle, the
         name along the foot. The branding slot is only honoured from Android 12 on;
         below that the pin and the background still show. -->
    <style name="Theme.StreetSweep.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_window</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBrandingImage" tools:targetApi="31">@drawable/splash_wordmark</item>
        <item name="postSplashScreenTheme">@style/Theme.StreetSweep</item>
    </style>
</resources>
