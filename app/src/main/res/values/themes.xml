<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.StreetSweep" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_window</item>
        <!-- Dark status and navigation icons: the screens are light, the map pale. The
             splash hand-over re-applies these, so they have to be said here as well as in
             StatusBarIcons, which turns them light over the sign-in photo. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- What the launcher draws while the process starts. Only the pin and the brand
         colour: the name goes beneath it in the app's own first frame, which the system
         splash cannot arrange (its icon slot is square and masked). -->
    <style name="Theme.StreetSweep.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_window</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.StreetSweep</item>
    </style>
</resources>
