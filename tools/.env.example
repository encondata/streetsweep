# Copy to .env and fill in. .env is git-ignored because the token is a secret.

# Shared secret required on every /api call. Generate one with:
#   openssl rand -hex 32
# Without it, anyone who reaches the server can read everywhere you have driven.
SYNC_TOKEN=

# The first administrator, used only while the database has no accounts at all.
# install.sh fills these in for you. After the account exists these are ignored,
# and a forgotten password is reset with:
#   docker compose exec web node reset-password.js you@example.com --make-admin
ADMIN_EMAIL=admin@streetsweep.local
ADMIN_PASSWORD=

# Where to publish the app for your reverse proxy to reach.
# Use 127.0.0.1 when the proxy runs on this same host.
BIND_ADDRESS=0.0.0.0
HOST_PORT=8420

# Photos attached to marked places are kept on a Docker volume, so there is
# nothing to configure here. If you are upgrading from the MinIO version, keep
# your old S3_* lines until you have run, once, with minio still running:
#   docker compose exec web node migrate-photos.js
# after which minio and those lines can go.
