# Copy to .env and fill in. .env is git-ignored because the token is a secret.

# Shared secret required on every /api call. Generate one with:
#   openssl rand -hex 32
# Without it, anyone who reaches the server can read everywhere you have driven.
SYNC_TOKEN=

# Where to publish the app for your reverse proxy to reach.
# Use 127.0.0.1 when the proxy runs on this same host.
BIND_ADDRESS=0.0.0.0
HOST_PORT=8420

# Photo storage. These are MinIO's credentials; change them before exposing
# anything, even though only the web service is meant to reach it.
S3_KEY=streetsweep
S3_SECRET=streetsweep-photos
S3_BUCKET=streetsweep-photos
