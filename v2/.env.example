# Copy to .env and adjust. Everything has a default.
# DATA_DIR=/mnt/cache/streetsweep-v2     # default: ~/streetsweep-v2-data
# HOST_PORT=8430
# BIND_ADDRESS=127.0.0.1                 # when a reverse proxy runs on this host
# POSTGRES_PASSWORD=change-me
# ADMIN_EMAIL=you@example.com            # first site admin, created on first boot
# ADMIN_PASSWORD=
# TIMEZONE=America/Chicago
# VALHALLA_URL=http://valhalla:8002
# OSM_EXTRACT_URL=https://download.geofabrik.de/north-america/us/texas-latest.osm.pbf   # the default
# CONTACT_EMAIL=you@example.com          # sent to Geofabrik / OpenStreetMap / Esri with requests
# Real outgoing mail instead of the Mailpit catcher:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false            # true for port 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=StreetSweep <no-reply@example.com>
# MAILPIT_UI_PORT=8025
